# Copy this file to .env and adjust as needed.

# SQLite local file — zero setup, no server or credentials needed.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead (see README.md "Nota importante: SQLite em vez de PostgreSQL"
# for the schema changes this requires), start it with `docker compose up -d` and use:
# DATABASE_URL="postgresql://marketing_ai_studio:marketing_ai_studio@localhost:5433/marketing_ai_studio?schema=public"

# All 5 agents (Editor-chefe, Redator LinkedIn, Redator Instagram, Redator de
# campanhas, Revisor) call real AI through the same provider abstraction.
#
# AI_MODE=live  -> agents try the real provider first, falling back to their own
#                   simulated output after retries/timeout are exhausted.
# AI_MODE=mock  -> every agent always uses its simulated output, no AI call is made.
# (Leaving AI_MODE unset behaves like "live", and any agent still falls back
# automatically if the selected provider's API key isn't set.)
AI_MODE=live
# AI_PROVIDER=anthropic | openai | gemini | lmstudio
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier option — no credit card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# lmstudio: any OpenAI-compatible local server (LM Studio, Ollama, etc). No API
# key needed — just the server's URL (include the /v1 suffix).
LM_STUDIO_BASE_URL=
AI_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# Max automatic Reviewer<->writer correction rounds per content item (not per
# project). Safe range 0-5; invalid or missing values fall back to 2.
AI_MAX_AUTOMATIC_REVISIONS=2

# Base URL used to build links back into the app (e.g. inside n8n notifications).
APP_BASE_URL=http://localhost:3000

# n8n Webhook-node URL. When set, the app POSTs a small JSON payload to it every
# time a content item reaches WAITING_HUMAN_APPROVAL (approved by the Reviewer,
# needs a human call, hit the automatic-revision limit, or was just manually
# corrected) — build a workflow in n8n with a Webhook trigger and whatever
# notification node you want (Slack/e-mail/Telegram/etc.) after it.
# Leave empty to keep this automation inactive.
N8N_APPROVAL_WEBHOOK_URL=http://localhost:5678/webhook-test/aprovacao-pendente
